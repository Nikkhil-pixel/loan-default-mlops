# Copy to .env for Docker Compose/local overrides. Do not commit .env.
RAW_DATA_PATH=data/raw/credit_risk_dataset.csv
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
MLFLOW_PORT=5000
MLFLOW_BACKEND_STORE_URI=sqlite:////app/mlflow/mlflow.db
MLFLOW_ARTIFACT_ROOT=file:///app/mlflow/artifacts
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000
HEALTH_PATH=/health
LOG_FILE=logs/predictions.jsonl
DVC_REMOTE_URL=./dvc-storage

# Remote-storage credentials are configured as GitHub repository secrets only.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
DAGSHUB_TOKEN=
